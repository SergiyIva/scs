[Unit]
Description=scs — эмбеддинг-сервис (Ollama за HTTP-контрактом §4)
# Ollama обязана быть раньше: без неё сервис поднимется и будет отдавать 500
# на каждый запрос, а поиск — молча деградировать.
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/WebstormProjects/embedded-project
ExecStart=/home/sergey/.nvm/versions/node/v22.22.0/bin/node dist/services/embed-ollama/server.js
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=default.target
