[Unit]
Description=scs — инкрементальная индексация кода
# Демон переживает недоступность эмбеддера, но без него не сделает ничего
# полезного, поэтому порядок задан явно.
After=network.target scs-embed.service
Wants=scs-embed.service
# Ограничитель перезапусков живёт в [Unit], а не в [Service]: в [Service]
# systemd его просто игнорирует («Unknown key»), и защита от бесконечного
# цикла рестартов, ради которой строки и написаны, не действует.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=@ROOT@
ExecStart=@NODE@ dist/src/bin/scs-daemon.js
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=default.target
