[Unit]
Description=scs — инкрементальная индексация кода
# Демон переживает недоступность эмбеддера, но без него не сделает ничего
# полезного, поэтому порядок задан явно.
After=network.target scs-embed.service
Wants=scs-embed.service

[Service]
Type=simple
WorkingDirectory=%h/WebstormProjects/embedded-project
ExecStart=/home/sergey/.nvm/versions/node/v22.22.0/bin/node dist/src/bin/scs-daemon.js
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=5
Environment=NODE_ENV=production

[Install]
WantedBy=default.target
