[Unit]
Description=scs — cross-encoder реранкер (§20)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/WebstormProjects/embedded-project
# LD_LIBRARY_PATH обязателен: onnxruntime-node собран под CUDA 12, а в системе
# 13.2, поэтому runtime-библиотеки лежат в локальном venv (npm run cuda:libs).
# Без него сервис поднимется на CPU и станет в двадцать раз медленнее — молча.
Environment=LD_LIBRARY_PATH=/home/sergey/WebstormProjects/embedded-project/.venv-cuda/lib/python3.14/site-packages/nvidia/cublas/lib:/home/sergey/WebstormProjects/embedded-project/.venv-cuda/lib/python3.14/site-packages/nvidia/cuda_nvrtc/lib:/home/sergey/WebstormProjects/embedded-project/.venv-cuda/lib/python3.14/site-packages/nvidia/cuda_runtime/lib:/home/sergey/WebstormProjects/embedded-project/.venv-cuda/lib/python3.14/site-packages/nvidia/cudnn/lib:/home/sergey/WebstormProjects/embedded-project/.venv-cuda/lib/python3.14/site-packages/nvidia/cufft/lib:/home/sergey/WebstormProjects/embedded-project/.venv-cuda/lib/python3.14/site-packages/nvidia/curand/lib:/home/sergey/WebstormProjects/embedded-project/.venv-cuda/lib/python3.14/site-packages/nvidia/nvjitlink/lib
ExecStart=/home/sergey/.nvm/versions/node/v22.22.0/bin/node dist/services/rerank-onnx/server.js
Restart=on-failure
RestartSec=5
# Загрузка модели на GPU занимает до полуминуты, и всё это время /health молчит.
TimeoutStartSec=120

[Install]
WantedBy=default.target
